{
  "extends": "./tsconfig.json",
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "mobile",
    "native",
    "docs",
    "**/*.test.*",
    "**/*.spec.*",
    "**/test.*",
    "**/spec.*",
    "**/__tests__/**",
    "**/__mocks__/**"
  ]
}
