# Public URLs for Google sign-in (src/account/config.ts). Both are public: no secret belongs in the app.
# Copy to .env.local (ignored by git) or set them in the build environment. Leave them out for a build that
# works signed out only. EXPO_PUBLIC_SITE_URL must be exactly the Convex deployment's SITE_URL origin, and that
# deployment must include the native sign-in handoff (convex/nativeSignInPlugin.ts): Google returns to the app with a
# one-time code that the app redeems at EXPO_PUBLIC_SITE_URL/api/auth/native-sign-in/exchange.
EXPO_PUBLIC_SITE_URL=https://www.versetogether.org
EXPO_PUBLIC_CONVEX_URL=https://<deployment>.convex.cloud
