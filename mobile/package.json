{
  "name": "verse-together-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "generate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-mobile-data.mjs",
    "generate:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-mobile-data.mjs --check",
    "check:published": "node scripts/check-published-guides.mjs",
    "release:preflight": "npm run generate:check && npm run check:published",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "jest",
    "export:android": "expo export --platform android --output-dir dist-android",
    "export:ios": "expo export --platform ios --output-dir dist-ios",
    "doctor": "expo-doctor",
    "brand": "node store/brand/render-brand.mjs",
    "brand:check": "node store/brand/render-brand.mjs --check",
    "build:android:store": "node scripts/build-android-store.mjs",
    "verify:android:bundle": "node scripts/verify-android-bundle.mjs"
  },
  "dependencies": {
    "@better-auth/expo": "~1.6.33",
    "@convex-dev/better-auth": "^0.12.5",
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "better-auth": "~1.6.33",
    "convex": "^1.48.0",
    "expo": "~58.0.20",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-font": "~58.0.10",
    "expo-image": "~58.0.17",
    "expo-linking": "~58.0.14",
    "expo-network": "~58.0.4",
    "expo-router": "~58.0.27",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.11",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-web-browser": "~58.0.7",
    "marked": "^17.0.6",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.88.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.3.0",
    "jest": "^30.5.2",
    "jest-expo": "^58.0.12",
    "react-dom": "19.3.0",
    "react-server-dom-webpack": "19.3.0",
    "test-renderer": "^1.3.1",
    "typescript": "~6.0.3"
  }
}
